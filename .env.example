# Copy to .env locally. Never commit real credentials.
# These secrets are backend-only; never use VITE_ or NEXT_PUBLIC_ prefixes.
EKT_API_USER=
EKT_API_PASSWORD=
LLM_API_KEY=
# OpenAI Responses API: enable only after configuring a key and data policy.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-sol
LLM_ALLOWED_MODELS=["gpt-6-sol"]
LLM_REASONING_EFFORT=medium
LLM_DATA_POLICY_ACCEPTED=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=8192
WORKER_TIMEOUT_SECONDS=75
WORKER_LEASE_SECONDS=120
LLM_SESSION_DAILY_TOKENS=100000
LLM_SITE_DAILY_TOKENS=1000000
# Catalog source: synthetic = demo catalog from data/synthetic (works without any DB or keys),
# catalog_db = PostgreSQL (DATABASE_URL, see data/db/README.md), unavailable = no catalog at all.
INTEGRATION_MODE=synthetic

# Scanner failures quarantine uploads. No bypass switch exists.
UPLOADS_ENABLED=false
# After installing ClamAV: ["C:/Program Files/ClamAV/clamscan.exe","--no-summary"]
# Windows with active Microsoft Defender: ["windows-defender"]
SCANNER_COMMAND=[]
# Catalog DB for INTEGRATION_MODE=catalog_db. An empty DB is migrated and filled with the demo
# catalog on start; a ready dump is in data/db/ekt_catalog.sql. Example: postgresql://user:pass@127.0.0.1:5432/ekt
DATABASE_URL=
# Re-read price and stock from the EKT API before cart actions (needs EKT_API_* above)
EKT_LIVE_REFRESH=false
# Legacy standalone PostgreSQL document adapter, not the HTTP upload path.
# HTTP uploads in both catalog modes use UPLOADS_ENABLED and SCANNER_COMMAND above.
CLAMD_SOCKET=
DOCUMENTS_ALLOW_UNSCANNED=false
# OCR for photos/scans and semantic search (participant 1).
# openai uses LLM_API_KEY + LLM_DATA_POLICY_ACCEPTED above; nvidia uses NVIDIA_API_KEY (build.nvidia.com).
AI_SERVICES_PROVIDER=openai
NVIDIA_API_KEY=
NVIDIA_DATA_POLICY_ACCEPTED=false
OCR_ENABLED=false
# Empty = provider default (openai: gpt-4.1-mini / text-embedding-3-small)
OCR_MODEL=
SEMANTIC_SEARCH_ENABLED=false
EMBED_MODEL=
